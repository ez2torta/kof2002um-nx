    "--at-clock=vblank", "--wait_reg_mem_log=true", "--texture_load_linear_direct=true", "--gpu_force_msaa_1x_from_2x=true", "--texture_load_cpu_direct=true", "--texture_load_cpu_poll=true", "--gpu_msaa_4x_alias_to_1x=true", "--resolve_copy_to_texture=true", "--resolve_skip_memory_after_copy=true",
