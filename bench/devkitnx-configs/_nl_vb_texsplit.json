{
  "name": "kof2002um-bench",
  "switch_ip": "192.168.0.137",
  "nxlink": "D:/Ports Swtch/devkitPro/tools/bin/nxlink.exe",
  "nro": "../../kof2002um-nx/kof2002um-nx.nro",
  "upload_path": "kof2002um-nx/kof2002um-nx-at2.nro",
  "args": [
    "--autotest=bench",
    "--perf",
    "--at-input=sdmc:/switch/kof2002um-nx/bench_input_vb.txt",
    "--vblank_per_swap=true",
    "--gpu_submission_timestamps=true",
    "--at-exit-at-end",
    "--at-exit-after=30000",
    "--vblank_per_swap_timeout_ms=20",
    "--at-clock=vblank",
    "--texture_load_split_timing=true",
    "--at-seed=1"
  ],
  "timeout_total": 1200,
  "budget_ms": 16.667,
  "perf_from_mark": "match_start",
  "expect": [
    {
      "mark": "boot",
      "within": 240
    },
    {
      "mark": "first_frame",
      "within": 180
    },
    {
      "mark": "match_start",
      "within": 600
    }
  ],
  "sysbotbase": {
    "enabled": false,
    "port": 6000,
    "before_run": [],
    "open_netloader": false,
    "netloader_wait": 1.5,
    "on_mark": {
      "match_start": [
        {
          "wait": 5
        },
        {
          "screenshot": "pelea"
        }
      ]
    },
    "on_finish": []
  }
}