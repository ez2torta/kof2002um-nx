# Mesa/NVK para Switch (libvulkan.a estático): mesa-switch @1a8c1a66d6f + el parche de nfsmw-nx, con el build de Linux de nfsmw-nx.
# Base Ubuntu 24.04 (LLVM 18 + libclc + SPIRV-LLVM-Translator para las herramientas del host); devkitPro se copia de la imagen oficial.
FROM devkitpro/devkita64:latest AS dkp

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive \
    DEVKITPRO=/opt/devkitpro \
    PATH=/root/.cargo/bin:/opt/devkitpro/devkitA64/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential pkg-config cmake ninja-build python3 python3-pip python3-venv \
        python3-mako python3-yaml python3-packaging python3-ply python3-numpy bison flex zlib1g-dev libzstd-dev libexpat1-dev \
        llvm-18-dev libclang-18-dev libclc-18-dev libllvmspirvlib-18-dev spirv-tools glslang-tools clang-18 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=dkp /opt/devkitpro /opt/devkitpro
# Meson >= 1.4 (Ubuntu trae 1.3)
RUN pip3 install --break-system-packages --no-cache-dir "meson>=1.4,<2"
# Rust + target del driver, y bindgen/cbindgen (Mesa rechaza bindgen 0.72.0 y < 0.71.1).
# static.rust-lang.org se corta a mitad de descarga (rust-std/rustc) desde este host: se usa el mirror de USTC.
ENV RUSTUP_DIST_SERVER=https://mirrors.ustc.edu.cn/rust-static \
    RUSTUP_UPDATE_ROOT=https://mirrors.ustc.edu.cn/rust-static/rustup
RUN for i in 1 2 3 4 5; do curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable && break || { echo "rustup intento $i falló"; sleep 10; }; done \
    && rustup target add aarch64-unknown-linux-gnu \
    && cargo install --locked bindgen-cli@0.72.1 cbindgen \
    && rm -rf /root/.cargo/registry /root/.cargo/git
# ninja con límite de hilos (JOBS): Mesa+Rust son pesados en RAM
RUN printf '#!/bin/sh\nexec /usr/bin/ninja -j"${JOBS:-3}" "$@"\n' > /usr/local/bin/ninja && chmod +x /usr/local/bin/ninja
COPY docker/build-mesa.sh /usr/local/bin/build-mesa
RUN chmod +x /usr/local/bin/build-mesa
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/build-mesa"]
